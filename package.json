{
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "name": "otherland",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "mops:setup": "mops install && mops toolchain init && mops toolchain use moc",
    "dfx": "bash scripts/dfx.sh",
    "deploy": "bash scripts/dfx.sh deploy",
    "deploy:clean": "bash scripts/dfx.sh deploy --clean"
  },
  "type": "module",
  "workspaces": [
    "src/otherland_client"
  ],
  "devDependencies": {
    "esprima": "^4.0.1",
    "npm-check-updates": "^17.1.18",
    "vite": "^8.2.1"
  },
  "dependencies": {}
}
